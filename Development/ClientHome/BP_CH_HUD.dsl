(event EventBeginPlay
(bind foundPotActor (Actor|GetAllActorswithTag :Tag "Home_Pot"))
(for item foundPotActor (Variables|Default|SetPotActor item))
(bind foundFurActor (Actor|GetAllActorswithTag :Tag "Home_Fur"))
(for item foundFurActor (Variables|Default|SetFurActor item))
(bind foundWindowActor (Actor|GetAllActorswithTag :Tag "Home_Window"))
(for item foundWindowActor (Variables|Default|SetWindowActor item))
(bind foundDoorActor (Actor|GetAllActorswithTag :Tag "Home_Door"))
(for item foundDoorActor (Variables|Default|SetDoorActor item))
(Variables|Default|SetTitle "의뢰인 집")
(Variables|Default|SetMessage "코코가 남긴 흔적을 찾아보자. 화분, 털, 창문을 조사하자.")
(Variables|Default|SetPopup true))
(event EventTick (DeltaSeconds)
(bind controller (HUD|GetOwningPlayerController))
(bind pawn (HUD|GetOwningPawn))
(Utilities|IsValid :InputObject pawn (:"Is Valid" (if (not (Variables|Default|GetComplete)) (Variables|Default|SetNearby 0)
(Variables|Default|SetPrompt "주변에서 코코의 흔적을 찾아보자.")
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetPotActor)) 165.0) (Variables|Default|SetNearby 1) (Variables|Default|SetPrompt "[E] 넘어진 화분 조사 / 확인"))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetFurActor)) 165.0) (Variables|Default|SetNearby 2) (Variables|Default|SetPrompt "[E] 고양이 털 조사 / 확인"))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetWindowActor)) 165.0) (Variables|Default|SetNearby 3) (Variables|Default|SetPrompt "[E] 열린 창문 조사 / 확인"))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetDoorActor)) 165.0) (Variables|Default|SetNearby 4) (Variables|Default|SetPrompt "[E] 현관문 조사 / 확인"))
(if (Variables|Default|GetPopup) (if (Game|Player|WasInputKeyJustPressed :self controller :Key "Enter") (CallFunction|Confirm)) (else (Pawn|Input|AddMovementInput :self pawn :WorldDirection "0,1,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "W") 1.0 0.0))
(Pawn|Input|AddMovementInput :self pawn :WorldDirection "0,-1,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "S") 1.0 0.0))
(Pawn|Input|AddMovementInput :self pawn :WorldDirection "1,0,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "A") 1.0 0.0))
(Pawn|Input|AddMovementInput :self pawn :WorldDirection "-1,0,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "D") 1.0 0.0))
(if (Game|Player|WasInputKeyJustPressed :self controller :Key "E") (CallFunction|Interact))))
(if (Variables|Default|GetDoorOpen) (Variables|Default|SetDoorAngle (select (> (+ (Variables|Default|GetDoorAngle) (* DeltaSeconds 100.0)) 90.0) 90.0 (+ (Variables|Default|GetDoorAngle) (* DeltaSeconds 100.0)))) (Transformation|SetActorRotation :self (Variables|Default|GetDoorActor) :NewRotation (Math|Rotator|MakeRotator :Yaw (- (Variables|Default|GetDoorAngle)))))
(bind position (Transformation|GetActorLocation :self pawn))
(if (and (Variables|Default|GetDoorOpen) (< (.y position) -570.0)) (Variables|Default|SetComplete true) (Variables|Default|SetTitle "집 조사 완료")
(Variables|Default|SetMessage "단서 3개를 확인하고 현관을 나왔다. 다음 목적지는 골목이다.")
(Variables|Default|SetPopup true)))) (:"Is Not Valid")))
(event EventReceiveDrawHUD (SizeX SizeY)
(HUD|DrawRect :ScreenX 20.0 :ScreenY 20.0 :ScreenW 540.0 :ScreenH 132.0 :RectColor "(R=0.025,G=0.04,B=0.05,A=0.94)")
(HUD|DrawText :Text "묘한 흔적을 찾아서  /  의뢰인 집" :ScreenX 38.0 :ScreenY 34.0 :Scale 1.5 :TextColor "(R=0.92,G=0.93,B=0.9,A=1)")
(HUD|DrawText :Text "WASD 이동   ·   E 조사   ·   Enter 확인" :ScreenX 38.0 :ScreenY 68.0 :Scale 1.2 :TextColor "(R=0.92,G=0.93,B=0.9,A=1)")
(HUD|DrawText :Text (select (== (Variables|Default|GetCount) 0) "조사한 단서: 0 / 3" (select (== (Variables|Default|GetCount) 1) "조사한 단서: 1 / 3" (select (== (Variables|Default|GetCount) 2) "조사한 단서: 2 / 3" "조사한 단서: 3 / 3"))) :ScreenX 38.0 :ScreenY 96.0 :Scale 1.2 :TextColor "(R=0.92,G=0.93,B=0.9,A=1)")
(HUD|DrawText :Text (Variables|Default|GetPrompt) :ScreenX 38.0 :ScreenY 124.0 :Scale 1.05 :TextColor "(R=0.92,G=0.93,B=0.9,A=1)")
(if (Variables|Default|GetDeduced) (HUD|DrawText :Text "추리: 창문으로 탈출  →  현관으로 나가기" :ScreenX 38.0 :ScreenY 166.0 :Scale 1.2 :TextColor "(R=0.92,G=0.93,B=0.9,A=1)"))
(if (Variables|Default|GetPopup) (HUD|DrawRect :ScreenX (* SizeX 0.10) :ScreenY (* SizeY 0.62) :ScreenW (* SizeX 0.80) :ScreenH 210.0 :RectColor "(R=0.02,G=0.035,B=0.045,A=0.98)")
(HUD|DrawText :Text (Variables|Default|GetTitle) :ScreenX (+ (* SizeX 0.10) 28.0) :ScreenY (+ (* SizeY 0.62) 22.0) :Scale 1.7 :TextColor "(R=1,G=0.72,B=0.32,A=1)")
(HUD|DrawText :Text (Variables|Default|GetMessage) :ScreenX (+ (* SizeX 0.10) 28.0) :ScreenY (+ (* SizeY 0.62) 72.0) :Scale 1.15 :TextColor "(R=0.92,G=0.93,B=0.9,A=1)")
(HUD|DrawText :Text "[Enter] 확인" :ScreenX (+ (* SizeX 0.10) 28.0) :ScreenY (+ (* SizeY 0.62) 144.0) :Scale 1.2 :TextColor "(R=0.92,G=0.93,B=0.9,A=1)")))