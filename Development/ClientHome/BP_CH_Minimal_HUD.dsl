(event EventBeginPlay
(CallFunction|InitPopup)
(bind foundSnackActor (Actor|GetAllActorswithTag :Tag "Home_Snack"))
(for item foundSnackActor (Variables|Default|SetSnackActor item))
(bind foundPawprintsActor (Actor|GetAllActorswithTag :Tag "Home_Pawprints"))
(for item foundPawprintsActor (Variables|Default|SetPawprintsActor item))
(bind foundExitActor (Actor|GetAllActorswithTag :Tag "Home_Exit"))
(for item foundExitActor (Variables|Default|SetExitActor item))

(bind foundPotActor (Actor|GetAllActorswithTag :Tag "Home_Pot"))
(for item foundPotActor (Variables|Default|SetPotActor item))
(bind foundFurActor (Actor|GetAllActorswithTag :Tag "Home_Fur"))
(for item foundFurActor (Variables|Default|SetFurActor item))
(bind foundWindowActor (Actor|GetAllActorswithTag :Tag "Home_Window"))
(for item foundWindowActor (Variables|Default|SetWindowActor item))
(bind foundDoorActor (Actor|GetAllActorswithTag :Tag "Home_Door"))
(for item foundDoorActor (Variables|Default|SetDoorActor item))
(Variables|Default|SetTitle "코코는 어디로 갔을까?")
(Variables|Default|SetMessage "코코가 어디로 갔을까? 집 안에 남은 다섯 가지 흔적을 찾아보자.")
(Variables|Default|SetPopup true)
(CallFunction|RefreshPopup))
(event EventTick (DeltaSeconds)
(CallFunction|SyncJournal)
(bind controller (HUD|GetOwningPlayerController))
(bind pawn (HUD|GetOwningPawn))
(Utilities|IsValid :InputObject pawn (:"Is Valid" (if (not (Variables|Default|GetComplete)) (Variables|Default|SetNearby 0)
(Variables|Default|SetNearestDistance 175.0)
(Variables|Default|SetPrompt "코코가 남긴 흔적을 찾아보자.")
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetPotActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetPotActor))) (Variables|Default|SetNearby 1) (Variables|Default|SetPrompt (select (Variables|Default|GetPotSeen) "[E] 넘어진 화분 다시 확인" "[E] 넘어진 화분 조사")))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetFurActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetFurActor))) (Variables|Default|SetNearby 2) (Variables|Default|SetPrompt (select (Variables|Default|GetFurSeen) "[E] 고양이 털 다시 확인" "[E] 고양이 털 조사")))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetWindowActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetWindowActor))) (Variables|Default|SetNearby 3) (Variables|Default|SetPrompt (select (Variables|Default|GetWindowSeen) "[E] 열린 창문 다시 확인" "[E] 열린 창문 조사")))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetDoorActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetDoorActor))) (Variables|Default|SetNearby 4) (Variables|Default|SetPrompt "[E] 현관문 확인"))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetSnackActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetSnackActor))) (Variables|Default|SetNearby 5) (Variables|Default|SetPrompt (select (Variables|Default|GetSnackSeen) "[E] 먹다 남은 간식 다시 확인" "[E] 먹다 남은 간식 조사")))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetPawprintsActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetPawprintsActor))) (Variables|Default|SetNearby 6) (Variables|Default|SetPrompt (select (Variables|Default|GetPawprintsSeen) "[E] 작은 발자국 다시 확인" "[E] 작은 발자국 조사")))
(if (Variables|Default|GetPopup) (if (Game|Player|WasInputKeyJustPressed :self controller :Key "Enter") (CallFunction|Confirm)) (else (Pawn|Input|AddMovementInput :self pawn :WorldDirection "0,1,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "W") 1.0 0.0))
(Pawn|Input|AddMovementInput :self pawn :WorldDirection "0,-1,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "S") 1.0 0.0))
(Pawn|Input|AddMovementInput :self pawn :WorldDirection "1,0,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "A") 1.0 0.0))
(Pawn|Input|AddMovementInput :self pawn :WorldDirection "-1,0,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "D") 1.0 0.0))
(if (Game|Player|WasInputKeyJustPressed :self controller :Key "E") (CallFunction|Interact))))
(if (Variables|Default|GetDoorOpen) (Variables|Default|SetDoorAngle (select (> (+ (Variables|Default|GetDoorAngle) (* DeltaSeconds 100.0)) 90.0) 90.0 (+ (Variables|Default|GetDoorAngle) (* DeltaSeconds 100.0)))) (Transformation|SetActorRotation :self (Variables|Default|GetDoorActor) :NewRotation (Math|Rotator|MakeRotator :Yaw (- (Variables|Default|GetDoorAngle)))))
(bind position (Transformation|GetActorLocation :self pawn))
(if (and (>= (Variables|Default|GetDoorAngle) 90.0) (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetExitActor)) 65.0)) (Variables|Default|SetComplete true) (Variables|Default|SetTitle "집 조사 완료")
(Variables|Default|SetMessage "다섯 가지 흔적을 모두 수첩에 담았어. 코코를 찾아 골목으로 가 보자!")
(Variables|Default|SetPopup true)
(CallFunction|RefreshPopup)))) (:"Is Not Valid")))
(event EventReceiveDrawHUD (SizeX SizeY)
(if (not (Variables|Default|GetPopup))
(if (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetPotActor)) 300.0)
(bind paw1 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetPotActor))))
(HUD|DrawTexture :Texture "/Game/ClientHome_Haeso/UI/Cozy/T_PawStamp.T_PawStamp" :ScreenX (- (.x paw1) 12.0) :ScreenY (- (.y paw1) 24.0) :ScreenW 24.0 :ScreenH 24.0 :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :TintColor "(R=0.95,G=0.65,B=0.38,A=1)")
)
(if (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetFurActor)) 300.0)
(bind paw2 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetFurActor))))
(HUD|DrawTexture :Texture "/Game/ClientHome_Haeso/UI/Cozy/T_PawStamp.T_PawStamp" :ScreenX (- (.x paw2) 12.0) :ScreenY (- (.y paw2) 24.0) :ScreenW 24.0 :ScreenH 24.0 :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :TintColor "(R=0.95,G=0.65,B=0.38,A=1)")
)
(if (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetWindowActor)) 300.0)
(bind paw3 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetWindowActor))))
(HUD|DrawTexture :Texture "/Game/ClientHome_Haeso/UI/Cozy/T_PawStamp.T_PawStamp" :ScreenX (- (.x paw3) 12.0) :ScreenY (- (.y paw3) 24.0) :ScreenW 24.0 :ScreenH 24.0 :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :TintColor "(R=0.95,G=0.65,B=0.38,A=1)")
)
(if (and (Variables|Default|GetDeduced) (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetExitActor)) 300.0))
(bind paw4 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetExitActor))))
(HUD|DrawTexture :Texture "/Game/ClientHome_Haeso/UI/Cozy/T_PawStamp.T_PawStamp" :ScreenX (- (.x paw4) 12.0) :ScreenY (- (.y paw4) 24.0) :ScreenW 24.0 :ScreenH 24.0 :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :TintColor "(R=0.95,G=0.65,B=0.38,A=1)")
)
(if (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetSnackActor)) 300.0)
(bind paw5 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetSnackActor))))
(HUD|DrawTexture :Texture "/Game/ClientHome_Haeso/UI/Cozy/T_PawStamp.T_PawStamp" :ScreenX (- (.x paw5) 12.0) :ScreenY (- (.y paw5) 24.0) :ScreenW 24.0 :ScreenH 24.0 :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :TintColor "(R=0.95,G=0.65,B=0.38,A=1)")
)
(if (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetPawprintsActor)) 300.0)
(bind paw6 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetPawprintsActor))))
(HUD|DrawTexture :Texture "/Game/ClientHome_Haeso/UI/Cozy/T_PawStamp.T_PawStamp" :ScreenX (- (.x paw6) 12.0) :ScreenY (- (.y paw6) 24.0) :ScreenW 24.0 :ScreenH 24.0 :TextureU 0.0 :TextureV 0.0 :TextureUWidth 1.0 :TextureVHeight 1.0 :TintColor "(R=0.95,G=0.65,B=0.38,A=1)")
)
))
