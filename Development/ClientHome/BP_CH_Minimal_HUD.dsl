(event EventBeginPlay
(CallFunction|InitPopup)
(bind foundSnackActor (Actor|GetAllActorswithTag :Tag "Home_Snack"))
(for item foundSnackActor (Variables|Default|SetSnackActor item))
(bind foundPawprintsActor (Actor|GetAllActorswithTag :Tag "Home_Pawprints"))
(for item foundPawprintsActor (Variables|Default|SetPawprintsActor item))
(bind foundExitActor (Actor|GetAllActorswithTag :Tag "Home_Exit"))
(for item foundExitActor (Variables|Default|SetExitActor item))

(bind foundPotActor (Actor|GetAllActorswithTag :Tag "Home_Pot"))
(for item foundPotActor (Variables|Default|SetPotActor item))
(bind foundFurActor (Actor|GetAllActorswithTag :Tag "Home_Fur"))
(for item foundFurActor (Variables|Default|SetFurActor item))
(bind foundWindowActor (Actor|GetAllActorswithTag :Tag "Home_Window"))
(for item foundWindowActor (Variables|Default|SetWindowActor item))
(bind foundDoorActor (Actor|GetAllActorswithTag :Tag "Home_Door"))
(for item foundDoorActor (Variables|Default|SetDoorActor item))
(Variables|Default|SetTitle "의뢰인 집")
(Variables|Default|SetMessage "창가의 화분, 의자 주변의 털, 열린 창문을 조사하자.")
(Variables|Default|SetPopup true)
(CallFunction|RefreshPopup))
(event EventTick (DeltaSeconds)
(bind controller (HUD|GetOwningPlayerController))
(bind pawn (HUD|GetOwningPawn))
(Utilities|IsValid :InputObject pawn (:"Is Valid" (if (not (Variables|Default|GetComplete)) (Variables|Default|SetNearby 0)
(Variables|Default|SetNearestDistance 175.0)
(Variables|Default|SetPrompt "주변에서 코코의 흔적을 찾아보자.")
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetPotActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetPotActor))) (Variables|Default|SetNearby 1) (Variables|Default|SetPrompt (select (Variables|Default|GetPotSeen) "[E] 넘어진 화분 다시 확인" "[E] 넘어진 화분 조사")))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetFurActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetFurActor))) (Variables|Default|SetNearby 2) (Variables|Default|SetPrompt (select (Variables|Default|GetFurSeen) "[E] 고양이 털 다시 확인" "[E] 고양이 털 조사")))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetWindowActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetWindowActor))) (Variables|Default|SetNearby 3) (Variables|Default|SetPrompt (select (Variables|Default|GetWindowSeen) "[E] 열린 창문 다시 확인" "[E] 열린 창문 조사")))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetDoorActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetDoorActor))) (Variables|Default|SetNearby 4) (Variables|Default|SetPrompt "[E] 현관문 확인"))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetSnackActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetSnackActor))) (Variables|Default|SetNearby 5) (Variables|Default|SetPrompt (select (Variables|Default|GetSnackSeen) "[E] 먹다 남은 간식 다시 확인" "[E] 먹다 남은 간식 조사 · 보조 단서")))
(if (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetPawprintsActor)) (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetPawprintsActor))) (Variables|Default|SetNearby 6) (Variables|Default|SetPrompt (select (Variables|Default|GetPawprintsSeen) "[E] 작은 발자국 다시 확인" "[E] 작은 발자국 조사 · 보조 단서")))
(if (Variables|Default|GetPopup) (if (Game|Player|WasInputKeyJustPressed :self controller :Key "Enter") (CallFunction|Confirm)) (else (Pawn|Input|AddMovementInput :self pawn :WorldDirection "1,0,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "W") 1.0 0.0))
(Pawn|Input|AddMovementInput :self pawn :WorldDirection "-1,0,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "S") 1.0 0.0))
(Pawn|Input|AddMovementInput :self pawn :WorldDirection "0,-1,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "A") 1.0 0.0))
(Pawn|Input|AddMovementInput :self pawn :WorldDirection "0,1,0" :ScaleValue (select (Game|Player|IsInputKeyDown :self controller :Key "D") 1.0 0.0))
(if (Game|Player|WasInputKeyJustPressed :self controller :Key "E") (CallFunction|Interact))))
(if (Variables|Default|GetDoorOpen) (Variables|Default|SetDoorAngle (select (> (+ (Variables|Default|GetDoorAngle) (* DeltaSeconds 100.0)) 90.0) 90.0 (+ (Variables|Default|GetDoorAngle) (* DeltaSeconds 100.0)))) (Transformation|SetActorRotation :self (Variables|Default|GetDoorActor) :NewRotation (Math|Rotator|MakeRotator :Yaw (- (Variables|Default|GetDoorAngle)))))
(bind position (Transformation|GetActorLocation :self pawn))
(if (and (>= (Variables|Default|GetDoorAngle) 90.0) (< (Transformation|GetHorizontalDistanceTo :self pawn :OtherActor (Variables|Default|GetExitActor)) 65.0)) (Variables|Default|SetComplete true) (Variables|Default|SetTitle "집 조사 완료")
(Variables|Default|SetMessage "단서 3개를 확인하고 현관문을 열었다. 다음 목적지는 골목이다.")
(Variables|Default|SetPopup true)
(CallFunction|RefreshPopup)))) (:"Is Not Valid")))
(event EventReceiveDrawHUD (SizeX SizeY)
(HUD|DrawRect :ScreenX 18 :ScreenY 16 :ScreenW 250 :ScreenH 64 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(HUD|DrawText :Text "의뢰인 집  /  흔적 찾기" :ScreenX 32 :ScreenY 25 :Scale 1.25 :TextColor "(R=0.94,G=0.95,B=0.9,A=1)")
(HUD|DrawText :Text "WASD 이동 · E 조사 · Enter 확인" :ScreenX 32 :ScreenY 54 :Scale 0.95 :TextColor "(R=0.94,G=0.95,B=0.9,A=1)")
(HUD|DrawRect :ScreenX (- SizeX 224) :ScreenY 16 :ScreenW 206 :ScreenH 90 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(HUD|DrawText :Text (select (== (Variables|Default|GetCount) 0) "핵심 단서 0 / 3" (select (== (Variables|Default|GetCount) 1) "핵심 단서 1 / 3" (select (== (Variables|Default|GetCount) 2) "핵심 단서 2 / 3" "핵심 단서 3 / 3"))) :ScreenX (- SizeX 208) :ScreenY 25 :Scale 1.25 :TextColor "(R=1,G=0.73,B=0.32,A=1)")
(HUD|DrawText :Text (select (== (Variables|Default|GetExtraCount) 0) "보조 단서 0 / 2 · 선택" (select (== (Variables|Default|GetExtraCount) 1) "보조 단서 1 / 2 · 선택" "보조 단서 2 / 2 · 선택")) :ScreenX (- SizeX 208) :ScreenY 53 :Scale 1.0 :TextColor "(R=0.4,G=0.9,B=0.7,A=1)")
(HUD|DrawText :Text (select (Variables|Default|GetDeduced) "현관으로 이동하세요" "주변의 흔적을 살펴보세요") :ScreenX (- SizeX 208) :ScreenY 80 :Scale 0.95 :TextColor "(R=0.94,G=0.95,B=0.9,A=1)")
(if (not (Variables|Default|GetPopup))
(HUD|DrawRect :ScreenX 18 :ScreenY (- SizeY 58) :ScreenW (- SizeX 36) :ScreenH 40 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(HUD|DrawText :Text (Variables|Default|GetPrompt) :ScreenX 32 :ScreenY (- SizeY 47) :Scale 1.2 :TextColor "(R=0.94,G=0.95,B=0.9,A=1)")
(if (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetPotActor)) 350.0)
(bind mark1 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetPotActor))))
(HUD|DrawRect :ScreenX (- (.x mark1) 6) :ScreenY (- (.y mark1) 6) :ScreenW 12 :ScreenH 12 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(if (Variables|Default|GetPotSeen)
(HUD|DrawRect :ScreenX (- (.x mark1) 4) :ScreenY (- (.y mark1) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark1) 1) :ScreenY (- (.y mark1) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(else
(HUD|DrawRect :ScreenX (- (.x mark1) 4) :ScreenY (- (.y mark1) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark1) 1) :ScreenY (- (.y mark1) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (== (Variables|Default|GetNearby) 1)
(HUD|DrawRect :ScreenX (+ (.x mark1) 12) :ScreenY (- (.y mark1) 32) :ScreenW 126 :ScreenH 28 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(HUD|DrawText :Text "[E] 화분" :ScreenX (+ (.x mark1) 20) :ScreenY (- (.y mark1) 27) :Scale 1.1 :TextColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetFurActor)) 350.0)
(bind mark2 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetFurActor))))
(HUD|DrawRect :ScreenX (- (.x mark2) 6) :ScreenY (- (.y mark2) 6) :ScreenW 12 :ScreenH 12 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(if (Variables|Default|GetFurSeen)
(HUD|DrawRect :ScreenX (- (.x mark2) 4) :ScreenY (- (.y mark2) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark2) 1) :ScreenY (- (.y mark2) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(else
(HUD|DrawRect :ScreenX (- (.x mark2) 4) :ScreenY (- (.y mark2) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark2) 1) :ScreenY (- (.y mark2) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (== (Variables|Default|GetNearby) 2)
(HUD|DrawRect :ScreenX (+ (.x mark2) 12) :ScreenY (- (.y mark2) 32) :ScreenW 126 :ScreenH 28 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(HUD|DrawText :Text "[E] 털" :ScreenX (+ (.x mark2) 20) :ScreenY (- (.y mark2) 27) :Scale 1.1 :TextColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetWindowActor)) 350.0)
(bind mark3 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetWindowActor))))
(HUD|DrawRect :ScreenX (- (.x mark3) 6) :ScreenY (- (.y mark3) 6) :ScreenW 12 :ScreenH 12 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(if (Variables|Default|GetWindowSeen)
(HUD|DrawRect :ScreenX (- (.x mark3) 4) :ScreenY (- (.y mark3) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark3) 1) :ScreenY (- (.y mark3) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(else
(HUD|DrawRect :ScreenX (- (.x mark3) 4) :ScreenY (- (.y mark3) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark3) 1) :ScreenY (- (.y mark3) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (== (Variables|Default|GetNearby) 3)
(HUD|DrawRect :ScreenX (+ (.x mark3) 12) :ScreenY (- (.y mark3) 32) :ScreenW 126 :ScreenH 28 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(HUD|DrawText :Text "[E] 창문" :ScreenX (+ (.x mark3) 20) :ScreenY (- (.y mark3) 27) :Scale 1.1 :TextColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (and (Variables|Default|GetDeduced) (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetExitActor)) 350.0))
(bind mark4 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetExitActor))))
(HUD|DrawRect :ScreenX (- (.x mark4) 6) :ScreenY (- (.y mark4) 6) :ScreenW 12 :ScreenH 12 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(if (Variables|Default|GetDeduced)
(HUD|DrawRect :ScreenX (- (.x mark4) 4) :ScreenY (- (.y mark4) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark4) 1) :ScreenY (- (.y mark4) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(else
(HUD|DrawRect :ScreenX (- (.x mark4) 4) :ScreenY (- (.y mark4) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark4) 1) :ScreenY (- (.y mark4) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (== (Variables|Default|GetNearby) 4)
(HUD|DrawRect :ScreenX (+ (.x mark4) 12) :ScreenY (- (.y mark4) 32) :ScreenW 126 :ScreenH 28 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(HUD|DrawText :Text "[E] 현관" :ScreenX (+ (.x mark4) 20) :ScreenY (- (.y mark4) 27) :Scale 1.1 :TextColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetSnackActor)) 350.0)
(bind mark5 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetSnackActor))))
(HUD|DrawRect :ScreenX (- (.x mark5) 6) :ScreenY (- (.y mark5) 6) :ScreenW 12 :ScreenH 12 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(if (Variables|Default|GetSnackSeen)
(HUD|DrawRect :ScreenX (- (.x mark5) 4) :ScreenY (- (.y mark5) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark5) 1) :ScreenY (- (.y mark5) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(else
(HUD|DrawRect :ScreenX (- (.x mark5) 4) :ScreenY (- (.y mark5) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark5) 1) :ScreenY (- (.y mark5) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (== (Variables|Default|GetNearby) 5)
(HUD|DrawRect :ScreenX (+ (.x mark5) 12) :ScreenY (- (.y mark5) 32) :ScreenW 126 :ScreenH 28 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(HUD|DrawText :Text "[E] 간식" :ScreenX (+ (.x mark5) 20) :ScreenY (- (.y mark5) 27) :Scale 1.1 :TextColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (< (Transformation|GetHorizontalDistanceTo :self (HUD|GetOwningPawn) :OtherActor (Variables|Default|GetPawprintsActor)) 350.0)
(bind mark6 (HUD|Project :Location (Transformation|GetActorLocation :self (Variables|Default|GetPawprintsActor))))
(HUD|DrawRect :ScreenX (- (.x mark6) 6) :ScreenY (- (.y mark6) 6) :ScreenW 12 :ScreenH 12 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(if (Variables|Default|GetPawprintsSeen)
(HUD|DrawRect :ScreenX (- (.x mark6) 4) :ScreenY (- (.y mark6) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark6) 1) :ScreenY (- (.y mark6) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=0.4,G=0.9,B=0.7,A=1)")
(else
(HUD|DrawRect :ScreenX (- (.x mark6) 4) :ScreenY (- (.y mark6) 1) :ScreenW 8 :ScreenH 2 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
(HUD|DrawRect :ScreenX (- (.x mark6) 1) :ScreenY (- (.y mark6) 4) :ScreenW 2 :ScreenH 8 :RectColor "(R=1,G=0.73,B=0.32,A=1)")
))
(if (== (Variables|Default|GetNearby) 6)
(HUD|DrawRect :ScreenX (+ (.x mark6) 12) :ScreenY (- (.y mark6) 32) :ScreenW 126 :ScreenH 28 :RectColor "(R=0.018,G=0.03,B=0.035,A=0.88)")
(HUD|DrawText :Text "[E] 발자국" :ScreenX (+ (.x mark6) 20) :ScreenY (- (.y mark6) 27) :Scale 1.1 :TextColor "(R=1,G=0.73,B=0.32,A=1)")
))
