        "properties": {
          "key": {
            "type": "string",
            "description": "\uc120\ud0dd\uc801\uc778 \ubaa8\ub514\ud30c\uc774\uc5b4\uac00 \ud3ec\ud568\ub41c \ud0a4 \uc774\ub984\uc785\ub2c8\ub2e4(\uc608: 'Enter', 'Ctrl+A', 'Shift+Tab')."
