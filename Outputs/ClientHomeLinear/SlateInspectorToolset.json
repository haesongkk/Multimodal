      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "boolean"
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "\uc2ac\ub808\uc774\ud2b8 \ud14d\uc2a4\ud2b8 \uc785\ub825 \uc704\uc82f\uc5d0 \ud14d\uc2a4\ud2b8\ub97c \uc785\ub825\ud569\ub2c8\ub2e4. \uc704\uc82f\uc5d0 \uba3c\uc800 \ud3ec\ucee4\uc2a4\ud55c \ub2e4\uc74c\n\uae00\uc790\ubcc4\ub85c \ud558\ub098\uc758 \ud0a4 \uc774\ubca4\ud2b8\ub97c \uc804\uc1a1\ud569\ub2c8\ub2e4.",
      "name": "SlateInspectorToolset.SlateInspectorToolset.Type",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "\uc2ac\ub808\uc774\ud2b8 \ud14d\uc2a4\ud2b8 \ubc15\uc2a4 \ub808\ud37c\ub7f0\uc2a4\uc785\ub2c8\ub2e4."
          },
          "text": {
            "type": "string",
            "description": "\uc785\ub825\ud560 \ud14d\uc2a4\ud2b8\uc785\ub2c8\ub2e4."
