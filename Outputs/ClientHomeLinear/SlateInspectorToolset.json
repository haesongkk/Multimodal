        "properties": {
          "returnValue": {
            "title": "ToolsetImage",
            "type": "object",
            "properties": {
              "mimeType": {
                "type": "string",
                "description": "\uc774\ubbf8\uc9c0\uac00 \uc778\ucf54\ub529\ub41c \ud3ec\ub9f7\uc785\ub2c8\ub2e4."
              },
              "data": {
                "type": "string",
                "description": "base64 \uc2a4\ud2b8\ub9c1\uc73c\ub85c \uc778\ucf54\ub529\ub41c \uc774\ubbf8\uc9c0 \ub370\uc774\ud130\uc785\ub2c8\ub2e4."
              }
            },
            "required": [
              "mimeType",
              "data"
            ]
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "\ud604\uc7ac \ud3ec\ucee4\uc2a4\ub41c \uc2ac\ub808\uc774\ud2b8 \uc704\uc82f\uc5d0\uc11c \ud0a4\ubcf4\ub4dc \ud0a4\ub97c \ub20c\ub800\ub2e4 \ub5cd\ub2c8\ub2e4.\n\ubaa8\ub514\ud30c\uc774\uc5b4 \uc811\ub450\uc0ac('Ctrl+C', 'Shift+1')\ub97c \uc9c0\uc6d0\ud569\ub2c8\ub2e4.",
