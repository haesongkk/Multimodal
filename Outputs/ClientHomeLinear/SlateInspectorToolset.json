            "description": "\uad00\ucc30\ud560 \ub8e8\ud2b8 \uc704\uc82f \ub808\ud37c\ub7f0\uc2a4\uc785\ub2c8\ub2e4. \ube44\uc5b4 \uc788\uc73c\uba74 \ud45c\uc2dc\ub418\ub294 \ubaa8\ub4e0 \ucc3d\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4."
          },
          "maxDepth": {
            "type": "integer",
            "description": "\ub8e8\ud2b8\uc5d0\uc11c \ud0d0\uc0c9\ud560 \ucd5c\ub300 \uae4a\uc774\uc785\ub2c8\ub2e4.",
