{
  "name": "SlateInspectorToolset.SlateInspectorToolset",
  "version": "1.0",
  "description": "\ud50c\ub808\uc774\ub77c\uc774\ud2b8 \uc2a4\ud0c0\uc77c\uc758 \uc2ac\ub808\uc774\ud2b8 UI \uc790\ub3d9\ud654 \ud234\uc138\ud2b8\uc785\ub2c8\ub2e4.\n\n\uc5b8\ub9ac\uc5bc \uc5d0\ub514\ud130 UI\ub97c \ud504\ub85c\uadf8\ub798\ubc0d \ubc29\uc2dd\uc73c\ub85c \uc81c\uc5b4\ud558\ub294 \ub370 \uc0ac\uc6a9\ub418\ub294\n\uc2a4\ub0c5\uc0f7, \uc2a4\ud06c\ub9b0\uc0f7, \uc778\ud130\ub799\uc158 \ud234\uc744 \ub178\ucd9c\ud569\ub2c8\ub2e4.  ModelContextProtocol \ud50c\ub7ec\uadf8\uc778\uc774\n\uc774\ub97c \uc790\ub3d9\uc73c\ub85c \ud0d0\uc9c0\ud560 \uc218 \uc788\ub3c4\ub85d UToolsetRegistry\ub97c \ud1b5\ud574 \ub4f1\ub85d\ub429\ub2c8\ub2e4.\n\n\uc595\uc740 \ub8e8\ud2b8 \uad00\ucc30\uc790(\ub381\uc2a4 0)\uac00 \ucd5c\uc0c1\uc704 \ucc3d\uc744 \uc9c0\uc18d\uc801\uc73c\ub85c\n\ud2b8\ub798\ud0b9\ud569\ub2c8\ub2e4.  \ud2b9\uc815 \ucc3d \ub610\ub294 \ud328\ub110\ub85c \uc791\uc5c5\ud558\uae30 \uc804\uc5d0 Observe()\ub97c \ud638\ucd9c\ud558\uc5ec\n\uae4a\uc740 \uc704\uc82f \ucee4\ubc84\ub9ac\uc9c0\ub97c \ud655\ubcf4\ud558\uace0, \uc791\uc5c5\uc774 \ub05d\ub098\uba74 Unobserve()\ub97c\n\ud638\ucd9c\ud558\uc138\uc694.  \uad00\ucc30\uc790\ub294 \uc57d 100ms\ub9c8\ub2e4 \uc11c\ube0c\ud2b8\ub9ac\ub97c \uc21c\ud68c\ud558\uc5ec \uc0c8\ub85c \ub098\ud0c0\ub09c \uc704\uc82f\uc5d0 \ub808\ud37c\ub7f0\uc2a4\ub97c \ud560\ub2f9\ud558\uace0\n\ub808\ud37c\ub7f0\uc2a4 \uce90\uc2dc\ub97c \ucd5c\uc2e0 \uc0c1\ud0dc\ub85c \uc720\uc9c0\ud569\ub2c8\ub2e4.\n\n\uc785\ub825 \uc2dc\ubbac\ub808\uc774\uc158\uc740 AutomationDriver \ub300\uc2e0 \uc9c1\uc811 \uc2ac\ub808\uc774\ud2b8 \uc774\ubca4\ud2b8 API(ProcessKeyCharEvent,\nProcessMouseButtonDownEvent \ub4f1)\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. AutomationDriver\uc758\n\ub3d9\uae30\uc2dd API\ub294 \uac8c\uc784 \uc2a4\ub808\ub4dc(MCP \ud234 \ud638\ucd9c\uc774 \uc2e4\ud589\ub418\ub294 \uc704\uce58)\uc5d0\uc11c \ud638\ucd9c\ub420 \ub54c\n\ub370\ub4dc\ub85d\uc744 \uc720\ubc1c\ud558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4.",
  "tools": [
    {
      "description": "\ucd5c\uc0c1\uc704 \uc2ac\ub808\uc774\ud2b8 \uc5d0\ub514\ud130 \ucc3d\uc744 \ub098\uc5f4\ud558\uac70\ub098, \uc120\ud0dd\ud558\uac70\ub098, \ub2eb\uc2b5\ub2c8\ub2e4.",
      "name": "SlateInspectorToolset.SlateInspectorToolset.Windows",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "'list'\ub294 JSON \ubc30\uc5f4\uc744 \ubc18\ud658\ud558\uace0, 'select'\ub294 \ucc3d\uc744 \ub9e8 \uc55e\uc73c\ub85c \uac00\uc838\uc624\uba70, 'close'\ub294 \ucc3d\uc744 \uc644\uc804\ud788 \uc18c\uba78\uc2dc\ud0b5\ub2c8\ub2e4.",
            "default": "list"
          },
          "index": {
            "type": "integer",
            "description": "\uc120\ud0dd/\ub2eb\uae30\ub97c \uc218\ud589\ud560 \ucc3d\uc758 \uc778\ub371\uc2a4\uc785\ub2c8\ub2e4.",
            "default": -1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "string"
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "\uc2ac\ub808\uc774\ud2b8 \uc704\uc82f \ud2b8\ub9ac \ub0b4\uc5d0 \ud14d\uc2a4\ud2b8\uac00 \uc788\ub294\uc9c0 \uc5ec\ubd80\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.\n\ube44\ube14\ub85c\ud0b9: \ud55c \ubc88\ub9cc \ud655\uc778\ud558\uace0 \uc989\uc2dc \ubc18\ud658\ud569\ub2c8\ub2e4. \ub300\uae30\ud558\uae30 \uc704\ud574 \ud3f4\ub9c1\ud569\ub2c8\ub2e4.",
      "name": "SlateInspectorToolset.SlateInspectorToolset.WaitFor",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "\uc788\uc5b4\uc57c \ud558\ub294 \ud14d\uc2a4\ud2b8\uc785\ub2c8\ub2e4(\ube44\uc5b4 \uc788\ub294 \uacbd\uc6b0 \uac74\ub108\ub700)."
          },
          "textGone": {
            "type": "string",
            "description": "\uc5c6\uc5b4\uc57c \ud558\ub294 \ud14d\uc2a4\ud2b8\uc785\ub2c8\ub2e4(\ube44\uc5b4 \uc788\ub294 \uacbd\uc6b0 \uac74\ub108\ub700)."
          }
        },
        "required": [
          "text",
          "textGone"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "boolean"
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "\ud574\ub2f9 \uc2dd\ubcc4\uc790\ub97c \uc0ac\uc6a9\ud558\uc5ec \uad00\ucc30\uc790\ub97c \uc81c\uac70\ud569\ub2c8\ub2e4.",
      "name": "SlateInspectorToolset.SlateInspectorToolset.Unobserve",
      "inputSchema": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Observe()\uac00 \ubc18\ud658\ud55c \uc2dd\ubcc4\uc790\uc785\ub2c8\ub2e4."
