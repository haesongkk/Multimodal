      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "boolean"
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "\uc2ac\ub808\uc774\ud2b8 UI \uc811\uadfc\uc131 \uc2a4\ub0c5\uc0f7\uc744 \ucea1\ucc98\ud569\ub2c8\ub2e4.  \ud604\uc7ac \uc704\uc82f \ud2b8\ub9ac\ub97c \uc77d\uace0\n\uc561\uc158 \ud234(\ud074\ub9ad, \ud0c0\uc785, \ud638\ubc84 \ub4f1)\uc744 \uc704\ud55c \ub808\ud37c\ub7f0\uc2a4\ub97c \ucc3e\ub294 \ub370 \uc774\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\n\uc595\uc740 \ub8e8\ud2b8 \uad00\ucc30\uc790(\ub381\uc2a4 0)\uac00 \ucd5c\uc0c1\uc704 \ucc3d\uc744 \uc790\ub3d9\uc73c\ub85c \ucee4\ubc84\ud569\ub2c8\ub2e4.\n\ud2b9\uc815 \ucc3d \ub610\ub294 \ud328\ub110\uacfc \uc778\ud130\ub799\uc158\ud558\uae30 \uc804\uc5d0 Observe()\ub97c \ud638\ucd9c\ud558\uc5ec \uae4a\uc740 \ucee4\ubc84\ub9ac\uc9c0\ub97c \ud655\ubcf4\ud55c \ub2e4\uc74c\n\ud574\ub2f9 \uc11c\ube0c\ud2b8\ub9ac\ub97c \uc2a4\ub0c5\uc0f7\ud558\uc5ec \ucf58\ud150\uce20\ub97c \ud655\uc778\ud558\uc138\uc694.\n\uc774\uc804 \uc2a4\ub0c5\uc0f7\uc5d0 \uc758\ud574 \uac80\uc0c9\ub41c \ub808\ud37c\ub7f0\uc2a4\ub294 \uc720\ud6a8\ud55c \uc0c1\ud0dc\ub85c \uc720\uc9c0\ub429\ub2c8\ub2e4. \ubaa8\ub4e0 \uc561\uc158\uc744 \uc218\ud589\ud558\uae30 \uc804\uc5d0\n\ub9e4\ubc88 \uc2a4\ub0c5\uc0f7\uc744 \ub2e4\uc2dc \ud638\ucd9c\ud560 \ud544\uc694\ub294 \uc5c6\uc2b5\ub2c8\ub2e4.",
      "name": "SlateInspectorToolset.SlateInspectorToolset.Snapshot",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "\uc11c\ube0c\ud2b8\ub9ac \ub8e8\ud2b8 \ub808\ud37c\ub7f0\uc2a4\uc785\ub2c8\ub2e4. \ube44\uc5b4 \uc788\ub294 \uacbd\uc6b0 \ubaa8\ub4e0 \ucc3d\uc744 \ub300\uc0c1\uc73c\ub85c \ud569\ub2c8\ub2e4."
          },
          "maxDepth": {
            "type": "integer",
            "description": "\ucd5c\ub300 \ub381\uc2a4(\ub514\ud3f4\ud2b8 30)\uc785\ub2c8\ub2e4.",
            "default": 30
          },
          "bIncludeSourceLocations": {
            "type": "boolean",
            "description": "\uac01 \uc704\uc82f\uc774 C++\uc758 \uc5b4\ub290 \uc704\uce58\uc5d0\uc11c \uc0dd\uc131\ub418\uc5c8\ub294\uc9c0 \ubcf4\uc5ec\uc8fc\ub294 [src=File:Line] \ud0dc\uadf8\ub97c \ud3ec\ud568\ud569\ub2c8\ub2e4.",
            "default": false
          }
        },
        "required": [
          "ref"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "returnValue": {
            "type": "string"
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "\ud14d\uc2a4\ud2b8 \ub77c\ubca8\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc2ac\ub808\uc774\ud2b8 \ucf64\ubcf4\ubc15\uc2a4\uc758 \uc635\uc158\uc744 \uc120\ud0dd\ud569\ub2c8\ub2e4.\n\ub4dc\ub86d\ub2e4\uc6b4\uc744 \uc5f4\uace0 \uc77c\uce58\ud558\ub294 \ud14d\uc2a4\ud2b8\ub97c \ucc3e\uc740 \ub2e4\uc74c \ud074\ub9ad\ud569\ub2c8\ub2e4.",
      "name": "SlateInspectorToolset.SlateInspectorToolset.SelectOption",
      "inputSchema": {
