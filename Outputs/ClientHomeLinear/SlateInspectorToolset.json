        "properties": {
          "returnValue": {
            "type": "boolean"
          }
        },
        "required": [
          "returnValue"
        ]
      }
    },
    {
      "description": "\uc704\uc82f \uc11c\ube0c\ud2b8\ub9ac\uc5d0 \uad00\ucc30\uc790\ub97c \ub4f1\ub85d\ud558\uc5ec \ub808\ud37c\ub7f0\uc2a4\uac00 \uc9c0\uc18d\uc801\uc73c\ub85c\n\ucd5c\uc2e0 \uc0c1\ud0dc\ub97c \uc720\uc9c0\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4(~100ms \ud2f1).  \uc791\uc5c5\ud560 \ucc3d\uc774\ub098 \ud328\ub110\uc5d0\uc11c\n\uc774 \ud568\uc218\ub97c \ud638\ucd9c\ud558\uc138\uc694. \ud574\ub2f9 \uc11c\ube0c\ud2b8\ub9ac\uc5d0 \uc0c8\ub85c \ub098\ud0c0\ub098\ub294 \uc704\uc82f\uc5d0\n\ub808\ud37c\ub7f0\uc2a4\uac00 \uc790\ub3d9\uc73c\ub85c \ud560\ub2f9\ub429\ub2c8\ub2e4.  \uc791\uc5c5\uc774 \ub05d\ub098\uba74 \uad00\ucc30\uc744 \uc911\ub2e8\ud558\uc138\uc694.\n\uc595\uc740 \ub8e8\ud2b8 \uad00\ucc30\uc790(\ub381\uc2a4 0)\ub294 \uc774\ubbf8 \ucd5c\uc0c1\uc704 \ucc3d\uc744 \ud3ec\ud568\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.",
