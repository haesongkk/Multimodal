(fn UpdateJournal (Found Hint Solved)
(Widget|SetText(Text) :self (Variables|WBP_CH_Popup|GetJournalCount) :InText (select (== Found 0) "0 / 5" (select (== Found 1) "1 / 5" (select (== Found 2) "2 / 5" (select (== Found 3) "3 / 5" (select (== Found 4) "4 / 5" "5 / 5"))))))
(Widget|SetText(Text) :self (Variables|WBP_CH_Popup|GetJournalPrompt) :InText Hint)
(Widget|SetText(Text) :self (Variables|WBP_CH_Popup|GetJournalGoal) :InText (select Solved "코코의 길을 찾았어! 현관으로 가자." "단서 다섯 개를 모아 볼까?"))
(Widget|SetRenderOpacity :self (Variables|WBP_CH_Popup|GetPawFound0) :InOpacity (select (> Found 0) 1.0 0.0))
(Widget|SetRenderOpacity :self (Variables|WBP_CH_Popup|GetPawFound1) :InOpacity (select (> Found 1) 1.0 0.0))
(Widget|SetRenderOpacity :self (Variables|WBP_CH_Popup|GetPawFound2) :InOpacity (select (> Found 2) 1.0 0.0))
(Widget|SetRenderOpacity :self (Variables|WBP_CH_Popup|GetPawFound3) :InOpacity (select (> Found 3) 1.0 0.0))
(Widget|SetRenderOpacity :self (Variables|WBP_CH_Popup|GetPawFound4) :InOpacity (select (> Found 4) 1.0 0.0)))